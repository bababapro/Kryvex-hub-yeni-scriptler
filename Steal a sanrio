local function getOwnBase()
    local bases = Workspace:FindFirstChild("Bases")
    if not bases then return nil end
    for _, base in ipairs(bases:GetChildren()) do
        local owner = base:FindFirstChild("OwnerName")
        if owner and owner.Value == LocalPlayer.Name then
            return base
        end
    end
    return nil
end

local function executeFinishSteal()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local overlay = Instance.new("ScreenGui")
    overlay.Name = "KryvexFinishOverlay"
    overlay.IgnoreGuiInset = true
    overlay.ResetOnSpawn = false
    overlay.Parent = playerGui

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.Parent = overlay

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = "Finishing Steal..."
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = bg

    local ownBase = getOwnBase()
    if ownBase then
        local spawnPart = ownBase:FindFirstChild("Spawn")
        if spawnPart then
            hrp.CFrame = spawnPart.CFrame + Vector3.new(0, 5, 0)
        end
        task.wait(math.random(1, 2))
        local claimZone = ownBase:FindFirstChild("ClaimZone")
        if claimZone then
            hrp.CFrame = claimZone.CFrame + Vector3.new(0, 5, 0)
        end
    else
        hrp.CFrame = CFrame.new(185.8063, 66.5858, 145.4864)
    end

    task.wait(1)
    overlay:Destroy()
end

