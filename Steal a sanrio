-- Loops
task.spawn(function()
    while true do
        if SanrioState.AutoLock then
            local base = getOwnBase()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local btn = base and base:FindFirstChild("Laser_Button")
            if hrp and btn and typeof(firetouchinterest) == "function" then
                pcall(function()
                    firetouchinterest(hrp, btn, 0)
                    task.wait(0.1)
                    firetouchinterest(hrp, btn, 1)
                end)
            end
        end
        task.wait(0.2)
    end
end)

task.spawn(function()
    while true do
        if SanrioState.AutoCollect then
            local base = getOwnBase()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if base and hrp and base:FindFirstChild("StoredModels") and typeof(firetouchinterest) == "function" then
                for i = 1, 25 do
                    local storage = base.StoredModels:FindFirstChild("Storage_" .. i)
                    local genPart = storage and storage:FindFirstChild("Generate") and storage.Generate:FindFirstChild("GeneratorPart")
                    if genPart then
                        pcall(function()
                            firetouchinterest(hrp, genPart, 0)
                            task.wait(0.05)
                            firetouchinterest(hrp, genPart, 1)
                        end)
                    end
                end
            end
        end
        task.wait(2)
    end
end)

task.spawn(function()
    while true do
        if SanrioState.InfSpin then
            local spinRemote = ReplicatedStorage:FindFirstChild("Free_Spin")
            if spinRemote then
                pcall(function() spinRemote:FireServer() end)
            end
        end
        task.wait(0.05)
    end
end)

if typeof(fireproximityprompt) == "function" then
    ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
        if prompt.HoldDuration > 0 then
            prompt.HoldDuration = 0
        end
        pcall(fireproximityprompt, prompt)
    end)
end

-- ESP & Movement
local espObjects = {}
local function setSanrioESP(enabled)
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(espObjects)

    if not enabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(220, 38, 38)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.Adornee = plr.Character
            hl.Parent = CoreGui
            table.insert(espObjects, hl)

            local head = plr.Character:FindFirstChild("Head")
            if head then
                local bb = Instance.new("BillboardGui")
                bb.Adornee = head
                bb.Size = UDim2.fromOffset(110, 28)
                bb.StudsOffset = Vector3.new(0, 2.2, 0)
                bb.AlwaysOnTop = true
                bb.Parent = CoreGui

                local txt = Instance.new("TextLabel")
                txt.Size = UDim2.fromScale(1, 1)
                txt.BackgroundTransparency = 1
                txt.Text = plr.Name
                txt.TextColor3 = Color3.fromRGB(255, 80, 80)
                txt.Font = Enum.Font.GothamBold
                txt.TextScaled = true
                txt.Parent = bb
                table.insert(espObjects, bb)
            end
        end
    end
end

local flyGyro, flyVel
local function setFly(enabled)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp or not hum then return end

    if flyGyro then flyGyro:Destroy() flyGyro = nil end
    if flyVel then flyVel:Destroy() flyVel = nil end

    if enabled then
        hum.PlatformStand = true
        flyGyro = Instance.new("BodyGyro")
        flyGyro.P = 90000
        flyGyro.MaxTorque = Vector3.new(90000, 90000, 90000)
        flyGyro.CFrame = hrp.CFrame
        flyGyro.Parent = hrp

        flyVel = Instance.new("BodyVelocity")
        flyVel.MaxForce = Vector3.new(90000, 90000, 90000)
        flyVel.Velocity = Vector3.zero
        flyVel.Parent = hrp
    else
        hum.PlatformStand = false
    end
end

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if SanrioState.Noclip and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if SanrioState.Fly and hrp and flyGyro and flyVel then
        local camCF = Workspace.CurrentCamera.CFrame
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.yAxis end

        flyVel.Velocity = moveDir.Magnitude > 0 and (moveDir.Unit * 120) or Vector3.zero
        flyGyro.CFrame = camCF
    end
end)

