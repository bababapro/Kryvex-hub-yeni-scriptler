                    local name = tool:GetAttribute("AnimalName") or tool.Name
                    local rarity = tool:GetAttribute("Rarity") or "Common"
                    local mut = tool:GetAttribute("Mutation")
                    local okR = not f1 or tbl9[rarity] == true
                    local okM = not f2 or tbl10[mut or "None"] == true
                    local okN = not f3 or tbl11[name] == true
                    if okR and okM and okN and aid and v22 then
                        pcall(function() v22:InvokeServer(aid) end)
                        task.wait(0.1)
                    end
                end
            end
        end
        task.wait(1)
    end
end

